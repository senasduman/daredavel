{
  "name": "daredavel-local",
  "version": "0.1.0",
  "private": true,
  "description": "Local multi-agent coding workspace",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "dev.daredavel.local",
    "productName": "Daredavel",
    "files": ["out/**/*", "package.json"],
    "asarUnpack": ["node_modules/node-pty/**"],
    "extraResources": [{ "from": "resources/icons", "to": "icons" }],
    "npmRebuild": false,
    "linux": { "target": ["AppImage", "deb"], "icon": "resources/icons/daredavel.png" },
    "mac": { "target": ["dmg"], "icon": "resources/icons/daredavel.icns" },
    "win": { "target": ["nsis"], "icon": "resources/icons/daredavel.ico" }
  }
}
